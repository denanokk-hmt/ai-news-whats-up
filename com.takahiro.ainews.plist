<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.takahiro.ainews</string>

    <!--
      caffeinate でラップして実行中のスリープを阻止する。
      cron はスリープ中だと「ダークウェイク」中に発火し、プロセスが数秒で
      再サスペンドされるため Gemini 通信が完了せず ReadTimeout で失敗していた。
      -i アイドルスリープ阻止 / -s システムスリープ阻止(AC時) / -u ユーザー活動を宣言。
      caffeinate は後続コマンドを実行し、終了するまでアサーションを保持する。
      別途 `sudo pmset repeat wake ... 06:58:00` で 07:00 発火前に物理ウェイクさせること。
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>-u</string>
        <string>/Users/takahiro/DevDev/ai-news-whats-up/.venv/bin/python</string>
        <string>-m</string>
        <string>src.main</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/takahiro/DevDev/ai-news-whats-up</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/takahiro/DevDev/ai-news-whats-up/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/takahiro/DevDev/ai-news-whats-up/logs/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
